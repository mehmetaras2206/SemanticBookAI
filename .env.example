# All settings are optional; the defaults work with docker compose.
# No API keys: the LLM and the embeddings run locally in Ollama, nothing leaves your machine.

# --- docker compose -----------------------------------------------------------
# Chat model served by Ollama (pulled on first start), e.g. gemma4:e4b or gemma4:12b
LLM_MODEL=qwen3.5:4b
# Dense embedding model, also served by Ollama
# EMBED_MODEL=bge-m3
# Prebuilt index restored on first start; set empty (INDEX_URL=) to build it from the books
# INDEX_URL=https://github.com/mehmetaras2206/SemanticBookAI/releases/download/index-v1/index.tar.gz
# Host port of the web UI
# WEB_PORT=8080

# --- local development (backend reads this file directly) ---------------------
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and adds ~2 s per request.
# OLLAMA_URL=http://127.0.0.1:11434
# Qdrant server; leave unset for embedded local mode in data/qdrant (slow for the full corpus)
# QDRANT_URL=http://127.0.0.1:6333
# OLLAMA_KEEP_ALIVE=1h
# EMBED_QUERY_ON_CPU=true
# LLM_TEMPERATURE=0.1
# LLM_NUM_CTX=4096

# Retrieval and guardrails
# CHAT_TOP_K=6
# RRF_K=60
# MIN_DENSE_SCORE=0.43
# MAX_QUESTION_CHARS=1000
