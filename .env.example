# All settings are optional; defaults work with docker compose.
# Local LLM served by Ollama (no API keys, nothing leaves your machine)
LLM_MODEL=gemma4:12b
# OLLAMA_URL=http://localhost:11434

# Qdrant: leave empty for embedded local mode (data/qdrant), or point to a server
# QDRANT_URL=http://localhost:6333

# DENSE_MODEL=jinaai/jina-embeddings-v2-base-de
# MIN_DENSE_SCORE=0.35
